# Wzorzec lokalnego środowiska testowego.
# To jest jedyna kanoniczna konfiguracja do pracy w repozytorium.
# Skrypty testowe blokują PBX_HOST=192.168.0.11 oraz hosty baz 192.168.0.8.
# Lokalna baza PostgreSQL dla pracy Codexa i testów ma zawsze nazwę ctip_test.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ctip_test
PGUSER=ctip_test
PGPASSWORD=ctip_test
PGSSLMODE=disable

FB_HOST=127.0.0.1
FB_PORT=3050
FB_MODE=local
FB_DATABASE=/tmp/test_ms.fdb
FB_USER=SYSDBA
FB_PASSWORD=masterkey
FB_CHARSET=UTF8
FB_ROLE=
FB_LOCAL_COPY_PATH=inbox/firebird/test_ms_local.fdb

FB_V_HOST=127.0.0.1
FB_V_PORT=3050
FB_V_DATABASE=/tmp/test_vmaintenance.fdb
FB_V_USER=SYSDBA
FB_V_PASSWORD=masterkey
FB_V_CHARSET=UTF8
FB_V_ROLE=

PBX_HOST=127.0.0.1
PBX_PORT=5525
PBX_PIN=1234

SMS_DEFAULT_SENDER=CTIP-Test
SMS_TYPE=eco+
SMS_API_URL=
SMS_API_TOKEN=
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_TEST_MODE=true

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER_NAME="CTIP Test"
EMAIL_SENDER_ADDRESS=test@example.com
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# Skrzynka automatyzacji umow:
# - test/lokalnie: umowy-test@ksero-partner.com.pl
# - produkcja (wdrozenie): umowy@ksero-partner.com.pl
MAILBOX_EMAIL_ADDRESS=umowy-test@ksero-partner.com.pl
MAILBOX_EMAIL_PASSWORD=
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=
MAILBOX_SMTP_PORT=465
MAILBOX_SMTP_USE_SSL=true
MAILBOX_SMTP_USE_STARTTLS=false
CONTRACTS_MAILBOX_SCHEDULER_ENABLED=true
CONTRACTS_MAILBOX_SYNC_INTERVAL_SECONDS=300
CONTRACTS_MAILBOX_SYNC_LIMIT=60
CONTRACTS_MAILBOX_SYNC_FOLDER=INBOX
CONTRACTS_MAILBOX_SYNC_TIMEOUT_SECONDS=300
CONTRACTS_MAILBOX_SYNC_REPROCESS=false
CONTRACTS_MAILBOX_ARCHIVE_ROOT=

# Opcjonalnie ustaw jawnie host publikowany w LAN, np. TEST_PUBLIC_HOST=192.168.0.9.
# Skrypty testowe ctiptest/run_test_stack_tmux.sh nadpisuja ponizsze URL-e adresem LAN
# wykrytym z hosta lub wartoscia TEST_PUBLIC_HOST.
ADMIN_PANEL_URL=http://localhost:8000/admin
FORM_PUBLIC_BASE_URL=http://localhost:8000
GRENKE_APP_BASE_URL=https://newonline.leasingoptymalny.pl
GRENKE_API_BASE_URL=https://newonline.leasingoptymalny.pl/API
GRENKE_TIMEOUT_SECONDS=12
FORM_LINK_TTL_HOURS=72
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_SESSION_REMEMBER_HOURS=12
