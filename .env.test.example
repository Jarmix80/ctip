SMS_TYPE=eco+
SMS_API_URL=
SMS_API_TOKEN=
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_TEST_MODE=true

# Lokalna symulacja wysyłek; nie łączy się z DPD i nie tworzy prawdziwych etykiet.
