# Wzorzec izolowanego środowiska testowego uruchamianego przez Docker Compose.
# Nie wolno wpisywać tutaj produkcyjnych hostów, kont ani sekretów.

CTIP_RUNTIME_PROFILE=test
LOCAL_UID=1000
LOCAL_GID=1000
OUTBOUND_DELIVERY_MODE=capture
OUTBOUND_AUDIT_DIR=logs/outbound_test
OUTBOUND_AUDIT_RETENTION_DAYS=14
TEST_NETWORK_ISOLATION_REQUIRED=true

PGHOST=postgres
PGPORT=5432
PGDATABASE=ctip_test
PGUSER=ctip_test
PGPASSWORD=ctip_test
PGSSLMODE=disable

# Odrębny sekret integracji serwerowej WordPress -> CRM. Ustaw własną wartość w .env.test.
CRM_WWW_TOKEN=change_me_test_www_token

FB_HOST=firebird
FB_PORT=3050
FB_MODE=network
FB_DATABASE=/data/BAZAMS_TEST.FDB
FB_USER=SYSDBA
FB_PASSWORD=ctip-test-only
FB_CHARSET=UTF8
FB_ROLE=
FB_LOCAL_COPY_PATH=.runtime-firebird/BAZAMS_TEST.FDB
FB_ALLOW_WRITES=false
FB_WAREHOUSE_ID=28
FB_WAREHOUSE_CLIENT_ID=656

FB_V_HOST=firebird
FB_V_PORT=3050
FB_V_DATABASE=BAZAMS_V_DISABLED
FB_V_USER=SYSDBA
FB_V_PASSWORD=ctip-test-only
FB_V_CHARSET=UTF8
FB_V_ROLE=

PBX_HOST=mock-ctip
PBX_PORT=5525
PBX_PIN=1234

