# PostgreSQL środowiska testowego
PGHOST=ctip-prod-mirror-postgres-1
PGPORT=5432
PGDATABASE=ctip_test
PGUSER=uzupelnij
PGPASSWORD=uzupelnij
PGSSLMODE=disable

# Lokalny Firebird BAZAMS_TEST, zawsze tylko do odczytu
FB_MODE=local
FB_HOST=ctip-prod-mirror-firebird-1
FB_PORT=3050
FB_DATABASE=/data/BAZAMS_TEST.FDB
FB_USER=uzupelnij
FB_PASSWORD=uzupelnij
FB_CHARSET=WIN1250
FB_ALLOW_WRITES=false

# Katalog tożsamości i kontrakt CHAT_KP
BOT_IDENTITY_ENABLED=true
BOT_IDENTITY_SECRET_KEY=uzupelnij
BOT_IDENTITY_CHAT_TOKEN=uzupelnij
BOT_IDENTITY_VOICE_TOKEN=uzupelnij
BOT_IDENTITY_TEST_SMS_CODE=123456
BOT_IDENTITY_SYNC_INTERVAL_SECONDS=300

# Bezwzględne zabezpieczenia środowiska laboratoryjnego
CRM_ENABLED=true
CRM_LAB_MODE=true
CRM_PUBLIC_PROTOTYPE_MODE=false
SMS_TEST_MODE=true
