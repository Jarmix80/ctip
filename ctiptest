#!/usr/bin/env bash
set -euo pipefail

WORKDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ENV_FILE:-${WORKDIR}/.env.test}"
PYTHON_BIN="${WORKDIR}/.venv/bin/python"
COMPOSE=(docker compose --project-directory "${WORKDIR}" --env-file "${ENV_FILE}" -f "${WORKDIR}/compose.test.yml")
ACTION="${1:-start}"

run_preflight() {
    if [[ ! -x "${PYTHON_BIN}" ]]; then
        echo "Brak środowiska ${WORKDIR}/.venv." >&2
        exit 1
    fi
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "Brak konfiguracji testowej ${ENV_FILE}." >&2
        exit 1
    fi
    set -a
    # shellcheck disable=SC1090
    source "${ENV_FILE}"
    set +a
    export CTIP_ENV_FILE="${ENV_FILE}"
    "${PYTHON_BIN}" "${WORKDIR}/scripts/test_env_preflight.py"
}

wait_for_web() {
    for _ in $(seq 1 60); do
        if curl --fail --silent --max-time 2 http://127.0.0.1:8000/health >/dev/null; then
            return 0
        fi
        sleep 2
    done
    echo "Aplikacja nie zgłosiła gotowości w ciągu 120 sekund." >&2
    "${COMPOSE[@]}" logs --tail=120 web
    return 1
}

case "${ACTION}" in
    start)
        run_preflight
        if [[ ! -f "${WORKDIR}/runtime/firebird/BAZAMS_TEST.FDB" ]]; then
            echo "Brak roboczej bazy runtime/firebird/BAZAMS_TEST.FDB." >&2
            exit 1
        fi
        "${COMPOSE[@]}" build
        "${COMPOSE[@]}" up -d --force-recreate
        wait_for_web
        "${COMPOSE[@]}" exec -T web python scripts/test_env_preflight.py --check-network
        echo "Test CTIP działa pod http://127.0.0.1:8000/."
        echo "Mailpit: http://127.0.0.1:8025/."
        ;;
    stop)
        "${COMPOSE[@]}" down --remove-orphans
        ;;
    status)
        "${COMPOSE[@]}" ps
        ;;
    logs)
        "${COMPOSE[@]}" logs --tail=200
        ;;
    reset-firebird)
        "${WORKDIR}/scripts/reset_test_firebird.sh"
        ;;
    rollback)
        "${WORKDIR}/scripts/rollback_test_environment.sh" "${2:-}"
        ;;
    *)
        echo "Użycie: ./ctiptest start|stop|status|logs|reset-firebird|rollback [archiwum]" >&2
        exit 2
        ;;
esac
