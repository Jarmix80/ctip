#!/usr/bin/env bash
set -euo pipefail

WORKDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ENV_FILE:-${WORKDIR}/.env.test}"
VENV_DIR="${CTIP_VENV_DIR:-${WORKDIR}/.venv}"
PYTHON_BIN="${VENV_DIR}/bin/python"
COMPOSE_RUNNER="${WORKDIR}/scripts/docker_compose.sh"
BUILD_RUNNER="${WORKDIR}/scripts/docker_build.sh"
COMPOSE=("${COMPOSE_RUNNER}" --project-directory "${WORKDIR}" --env-file "${ENV_FILE}" -f "${WORKDIR}/compose.test.yml")
COMPOSE_SERVER=("${COMPOSE[@]}" -f "${WORKDIR}/compose.test.server.yml")
ACTION="${1:-start}"

full_revision() {
    git -C "${WORKDIR}" rev-parse HEAD
}

server_image() {
    printf '%s\n' "${CTIP_TEST_IMAGE:-ctip/test-runtime:$(full_revision)}"
}

run_preflight() {
    if [[ ! -x "${PYTHON_BIN}" ]]; then
        echo "Brak środowiska ${VENV_DIR}." >&2
        exit 1
    fi
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "Brak konfiguracji testowej ${ENV_FILE}." >&2
        exit 1
    fi
    env -i \
        HOME="${HOME}" \
        PATH="${PATH}" \
        LANG="${LANG:-C.UTF-8}" \
        CTIP_ENV_FILE="${ENV_FILE}" \
        "${PYTHON_BIN}" "${WORKDIR}/scripts/test_env_preflight.py"
}

validate_server_compose() {
    local image="$1"
    CTIP_TEST_IMAGE="${image}" "${COMPOSE_SERVER[@]}" config --format json \
        | "${PYTHON_BIN}" "${WORKDIR}/scripts/test_server_compose_check.py" \
            --expected-image "${image}" --check-filesystem
}

validate_image() {
    local image="$1"
    local expected_revision actual_revision
    expected_revision="$(full_revision)"
    docker image inspect "${image}" >/dev/null
    actual_revision="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "${image}")"
    if [[ "${actual_revision}" != "${expected_revision}" ]]; then
        echo "Obraz ${image} ma rewizję ${actual_revision}, oczekiwano ${expected_revision}." >&2
        exit 1
    fi
}

verify_test_database() {
    local image="$1"
    local network
    network="$(test_database_network)"
    docker run --rm \
        --network "${network}" \
        --env-file "${ENV_FILE}" \
        -e CTIP_ENV_FILE=/app/.env.test \
        -e PYTHONPATH=/app \
        -e CTIP_RUNTIME_PROFILE=test \
        -e PGHOST=postgres \
        -e PGDATABASE=ctip_test \
        -e SMS_TEST_MODE=true \
        -e OUTBOUND_DELIVERY_MODE=capture \
        -e BLOCK_CLIENT_COMMUNICATIONS=true \
        -e FB_ALLOW_WRITES=false \
        "${image}" python scripts/verify_alembic_state.py
}

test_postgres_container() {
    local project container
    for project in ctip-test ctip-prod-mirror; do
        container="$(docker ps \
            --filter "label=com.docker.compose.project=${project}" \
            --filter label=com.docker.compose.service=postgres \
            --format '{{.ID}}' | head -n 1)"
        if [[ -n "${container}" ]]; then
            printf '%s\n' "${container}"
            return 0
        fi
    done
    echo "Nie znaleziono działającego testowego PostgreSQL." >&2
    return 1
}

test_database_network() {
    local postgres_container
    postgres_container="$(test_postgres_container)"
    docker inspect \
        --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' \
        "${postgres_container}" | head -n 1
}

migrate_test_database() {
    local image="$1"
    local network
    network="$(test_database_network)"
    docker run --rm \
        --network "${network}" \
        --env-file "${ENV_FILE}" \
        -e CTIP_ENV_FILE=/app/.env.test \
        -e CTIP_RUNTIME_PROFILE=test \
        -e PGHOST=postgres \
        -e PGDATABASE=ctip_test \
        -e SMS_TEST_MODE=true \
        -e OUTBOUND_DELIVERY_MODE=capture \
        -e BLOCK_CLIENT_COMMUNICATIONS=true \
        -e FB_ALLOW_WRITES=false \
        "${image}" python -m alembic upgrade head
}

reconcile_test_database() {
    local image="$1"
    local backup_dir="$2"
    local network
    network="$(test_database_network)"
    docker run --rm \
        --network "${network}" \
        --env-file "${ENV_FILE}" \
        -e CTIP_ENV_FILE=/app/.env.test \
        -e PYTHONPATH=/app \
        -e CTIP_RUNTIME_PROFILE=test \
        -e PGHOST=postgres \
        -e PGDATABASE=ctip_test \
        -e SMS_TEST_MODE=true \
        -e OUTBOUND_DELIVERY_MODE=capture \
        -e BLOCK_CLIENT_COMMUNICATIONS=true \
        -e FB_ALLOW_WRITES=false \
        --mount "type=bind,src=${backup_dir},dst=/backup,readonly" \
        "${image}" python scripts/reconcile_test_alembic_state.py \
            --apply --backup-manifest /backup/SHA256SUMS
}

wait_for_url() {
    local url="$1"
    local label="$2"
    for _ in $(seq 1 60); do
        if curl --fail --silent --max-time 2 "${url}" >/dev/null; then
            return 0
        fi
        sleep 2
    done
    echo "${label} nie zgłosił gotowości w ciągu 120 sekund." >&2
    return 1
}

wait_for_persistent_services() {
    local services service container state stable_passes
    services=(
        postgres firebird mailpit mock-ctip google-egress web forms-public
        collector sms-sender bot-identity-api bot-identity-sync crm lab test-gateway
    )
    stable_passes=0
    for _ in $(seq 1 60); do
        state="running"
        for service in "${services[@]}"; do
            container="$(CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" ps -q "${service}")"
            if [[ -z "${container}" ]] || [[ "$(docker inspect --format '{{.State.Status}}' "${container}")" != "running" ]]; then
                state="waiting"
                break
            fi
        done
        if [[ "${state}" == "running" ]]; then
            stable_passes=$((stable_passes + 1))
            if (( stable_passes >= 5 )); then
                return 0
            fi
        else
            stable_passes=0
        fi
        sleep 2
    done
    echo "Nie wszystkie procesy stosu pozostały stabilne przez 10 sekund." >&2
    return 1
}

ensure_no_recent_runtime_errors() {
    local services service container recent_logs
    services=(web forms-public collector sms-sender bot-identity-sync)
    for service in "${services[@]}"; do
        container="$(CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" ps -q "${service}")"
        recent_logs="$(docker logs --since 5m "${container}" 2>&1 || true)"
        if rg -q 'Traceback|[[:space:]]ERROR[[:space:]]' <<<"${recent_logs}"; then
            echo "Usługa ${service} zgłosiła świeży błąd podczas bieżącego startu." >&2
            return 1
        fi
    done
}

wait_for_stack() {
    wait_for_url "http://127.0.0.1:8000/health" "CTIP"
    wait_for_url "http://192.168.0.9:8001/health" "CRM"
    wait_for_url "http://192.168.0.9:8790/health" "LAB"
    wait_for_persistent_services
    CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" exec -T bot-identity-api \
        python scripts/check_bot_identity_test_runtime.py --max-wait-seconds 120
    ensure_no_recent_runtime_errors
}

backup_test_data() {
    local timestamp backup_dir postgres_container firebird_file
    timestamp="$(date +%Y%m%d_%H%M%S)"
    backup_dir="${CTIP_TEST_BACKUP_DIR:-${WORKDIR}/backups/test-cutover}/${timestamp}"
    mkdir -p "${backup_dir}"
    postgres_container="$(test_postgres_container)"
    docker exec "${postgres_container}" pg_dump -U ctip_test -d ctip_test -Fc \
        >"${backup_dir}/ctip_test.dump"
    firebird_file="$(CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" config --format json \
        | "${PYTHON_BIN}" "${WORKDIR}/scripts/test_server_compose_check.py" --print-firebird-file)"
    cp --reflink=auto --preserve=timestamps "${firebird_file}" "${backup_dir}/BAZAMS_TEST.FDB"
    (cd "${backup_dir}" && sha256sum ctip_test.dump BAZAMS_TEST.FDB >SHA256SUMS)
    printf '%s\n' "${backup_dir}"
}

legacy_running_containers() {
    local project
    for project in ctip-prod-mirror ctip-bot-identity ctip-crm-lab-test; do
        docker ps --filter "label=com.docker.compose.project=${project}" --format '{{.ID}}'
    done | sort -u
}

prepare_cutover_state() {
    local state_dir current_container previous_image
    state_dir="${WORKDIR}/runtime/deployments/test-cutover-$(date +%Y%m%d_%H%M%S)"
    mkdir -p "${state_dir}"
    legacy_running_containers >"${state_dir}/legacy-containers.txt"
    current_container="$(docker ps \
        --filter label=com.docker.compose.project=ctip-test \
        --filter label=com.docker.compose.service=web \
        --format '{{.ID}}' | head -n 1)"
    if [[ -n "${current_container}" ]]; then
        previous_image="$(docker inspect --format '{{.Config.Image}}' "${current_container}")"
        printf '%s\n' "${previous_image}" >"${state_dir}/previous-image.txt"
    fi
    printf '%s\n' "${state_dir}"
}

stop_container_list() {
    local file="$1"
    if [[ -s "${file}" ]]; then
        xargs --no-run-if-empty docker stop <"${file}" >/dev/null
    fi
}

start_container_list() {
    local file="$1"
    if [[ -s "${file}" ]]; then
        xargs --no-run-if-empty docker start <"${file}" >/dev/null
    fi
}

rollback_cutover() {
    local state_dir="$1" previous_image
    CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" stop || true
    if [[ -s "${state_dir}/previous-image.txt" ]]; then
        previous_image="$(cat "${state_dir}/previous-image.txt")"
        CTIP_TEST_IMAGE="${previous_image}" "${COMPOSE_SERVER[@]}" up -d --force-recreate
    else
        start_container_list "${state_dir}/legacy-containers.txt"
    fi
    echo "Przywrócono poprzedni stos testowy; stan: ${state_dir}."
}

case "${ACTION}" in
    start)
        run_preflight
        export CTIP_TEST_REVISION="$(full_revision)"
        export CTIP_TEST_IMAGE="ctip/test-runtime:development"
        "${COMPOSE[@]}" build
        "${COMPOSE[@]}" up -d --force-recreate
        wait_for_url "http://127.0.0.1:8000/health" "CTIP"
        "${COMPOSE[@]}" exec -T web python scripts/test_env_preflight.py --check-network
        ;;
    server-build)
        run_preflight
        image="$(server_image)"
        "${BUILD_RUNNER}" \
            --build-arg "VCS_REF=$(full_revision)" \
            --label "org.opencontainers.image.revision=$(full_revision)" \
            --tag "${image}" \
            --file "${WORKDIR}/Dockerfile.test" \
            "${WORKDIR}"
        validate_image "${image}"
        echo "Zbudowano niezmienny obraz testowy ${image}."
        ;;
    server-check)
        run_preflight
        image="$(server_image)"
        validate_image "${image}"
        validate_server_compose "${image}"
        verify_test_database "${image}"
        ;;
    server-migrate)
        run_preflight
        image="$(server_image)"
        validate_image "${image}"
        validate_server_compose "${image}"
        backup_dir="$(backup_test_data)"
        migrate_test_database "${image}"
        verify_test_database "${image}"
        echo "Baza ctip_test jest na głowie grafu; backup: ${backup_dir}."
        ;;
    server-reconcile)
        run_preflight
        image="$(server_image)"
        validate_image "${image}"
        validate_server_compose "${image}"
        backup_dir="$(backup_test_data)"
        reconcile_test_database "${image}" "${backup_dir}"
        verify_test_database "${image}"
        echo "Uzgodniono historię testowej bazy; backup: ${backup_dir}."
        ;;
    server-cutover)
        run_preflight
        image="$(server_image)"
        validate_image "${image}"
        validate_server_compose "${image}"
        verify_test_database "${image}"
        backup_dir="$(backup_test_data)"
        state_dir="$(prepare_cutover_state)"
        printf '%s\n' "${backup_dir}" >"${state_dir}/backup-path.txt"
        stop_container_list "${state_dir}/legacy-containers.txt"
        if ! CTIP_TEST_IMAGE="${image}" "${COMPOSE_SERVER[@]}" up -d --force-recreate; then
            rollback_cutover "${state_dir}"
            exit 1
        fi
        if ! wait_for_stack; then
            CTIP_TEST_IMAGE="${image}" "${COMPOSE_SERVER[@]}" logs --tail=160
            rollback_cutover "${state_dir}"
            exit 1
        fi
        printf '%s\n' "${state_dir}" >"${WORKDIR}/runtime/deployments/current-test-cutover"
        echo "Stos ctip-test działa na porcie 8000; backup: ${backup_dir}."
        ;;
    server-rollback)
        state_dir="${2:-}"
        if [[ -z "${state_dir}" && -f "${WORKDIR}/runtime/deployments/current-test-cutover" ]]; then
            state_dir="$(cat "${WORKDIR}/runtime/deployments/current-test-cutover")"
        fi
        if [[ -z "${state_dir}" || ! -f "${state_dir}/legacy-containers.txt" ]]; then
            echo "Brak poprawnego katalogu stanu rollbacku." >&2
            exit 1
        fi
        rollback_cutover "${state_dir}"
        ;;
    server-status)
        CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" ps
        ;;
    server-logs)
        CTIP_TEST_IMAGE="$(server_image)" "${COMPOSE_SERVER[@]}" logs --tail=200
        ;;
    stop)
        "${COMPOSE[@]}" stop
        ;;
    status)
        "${COMPOSE[@]}" ps
        ;;
    logs)
        "${COMPOSE[@]}" logs --tail=200
        ;;
    reset-firebird)
        "${WORKDIR}/scripts/reset_test_firebird.sh"
        ;;
    rollback)
        "${WORKDIR}/scripts/rollback_test_environment.sh" "${2:-}"
        ;;
    *)
        echo "Użycie: ./ctiptest start|server-build|server-check|server-migrate|server-reconcile|server-cutover|server-rollback [stan]|server-status|server-logs|stop|status|logs|reset-firebird|rollback [archiwum]" >&2
        exit 2
        ;;
esac
