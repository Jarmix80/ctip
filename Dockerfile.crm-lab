FROM python@sha256:1042b61448fef4ba92d16a8c7eb4996d027568ce64792a7877fd88511e0af7c6

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 ctip \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin ctip

COPY --chown=10001:10001 app ./app
COPY --chown=10001:10001 scripts/crm_lab_test_preflight.py ./scripts/crm_lab_test_preflight.py

ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="CTIP CRM/LAB TEST" \
      org.opencontainers.image.description="Izolowany testowy runtime CRM i laboratorium CTIP" \
      org.opencontainers.image.revision="${VCS_REF}"

USER 10001:10001

CMD ["python", "-m", "uvicorn", "app.crm_prototype_app:app", "--host", "0.0.0.0", "--port", "8001", "--lifespan", "off"]
